# Copy to .env — the API (pydantic-settings) and docker-compose both read this file.

API_V1_STR=/api/v1
PROJECT_NAME=Orbitium
ENVIRONMENT=local

# Origin of the web app, added to CORS automatically.
FRONTEND_HOST=http://localhost:3000
# Extra allowed origins, comma-separated (optional).
BACKEND_CORS_ORIGINS=

# docker-compose publishes Postgres on 5433 to avoid clashing with a local install.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orbitium

# Directory containing the compiled engine binary (defaults to ../engine relative to the API).
# ENGINE_PATH=
